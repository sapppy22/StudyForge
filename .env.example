# ---------------------------------------------------------------------------
# StudyForge environment configuration
# Copy this file to `.env.local` (or `.env`) and fill in the values.
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma. When using Supabase, this is the
# "Connection string" from Project Settings → Database.
#
# Use the Supavisor pooler on port 6543 with `?pgbouncer=true&connection_limit=1`.
# The direct host `db.<ref>.supabase.co:5432` is IPv6-only *and* Supabase has
# stopped accepting connections on 5432 for at least some projects (it refuses
# the TCP connect outright, which Prisma reports as "Can't reach database
# server"). Port 6543 on the same hostname is the pooler and expects the plain
# `postgres` username — not the `postgres.<ref>` form used by the regional
# `aws-N-<region>.pooler.supabase.com` hosts.
#
# The database must have the pgvector extension available (the initial
# migration enables it).
DATABASE_URL="postgresql://postgres:password@db.<ref>.supabase.co:6543/postgres?schema=public&pgbouncer=true&connection_limit=1"

# Supabase project credentials (Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# Current-generation key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy JWT key. Only needed for projects that haven't rotated to a
# publishable key — the publishable key wins when both are set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Public base URL of the app — used for OAuth redirect callbacks.
# In development this is usually http://localhost:3000.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Guest mode lets someone use the whole app with no account: a signed http-only
# cookie plus a `profiles` row, promoted onto a real account (data and all) if
# they sign up later. Set to "false" to require sign-up.
NEXT_PUBLIC_ENABLE_GUEST_MODE="true"

# HMAC key for guest session cookies. Optional — one is derived from the
# server-only config when unset — but set it explicitly in production so guest
# sessions survive a DATABASE_URL rotation. `openssl rand -hex 32`.
GUEST_SESSION_SECRET=""

# Comma-separated social providers to offer on the login screen, e.g.
# "google,github". Only list providers enabled in the Supabase dashboard
# (Authentication → Providers) — anything else dead-ends at the redirect.
# Leave empty for email/password + guest only.
NEXT_PUBLIC_OAUTH_PROVIDERS=""

# Anthropic API key (optional). When set, StudyForge uses Claude to generate
# questions, grade subjective answers, build flashcards and power the tutor
# chatbot. When unset, the app falls back to fully-offline deterministic
# generators so every feature still works end-to-end without a key.
ANTHROPIC_API_KEY=""

# Resend API key (optional). When unset, performance reports and digests are
# recorded as in-app notifications instead of being emailed.
RESEND_API_KEY=""
EMAIL_FROM="StudyForge <reports@studyforge.app>"
