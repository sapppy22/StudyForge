// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExamType {
  CLASS_9
  CLASS_10
  JEE_MAIN
  JEE_ADVANCED
  NEET
  BITSAT
  CUET_UG
  GATE
  NDA
  SSC_CGL
  SSC_CHSL
  IBPS_PO
  RRB_NTPC
  CTET
  UPSC
  CLAT
  CAT
  GRE
  GMAT
  IELTS
  TOEFL
  CUSTOM
}

enum GoalStatus {
  active
  archived
}

enum TopicStatus {
  not_started
  learning
  reviewing
  mastered
}

enum ContentType {
  note
  video
  pdf
  image
  web_article
}

enum QuestionType {
  mcq
  msq
  numeric
  assertion_reason
  short_answer
  long_answer
  derivation
  proof
}

enum Difficulty {
  easy
  medium
  hard
}

enum QuestionSource {
  llm_generated
  user_notes_grounded
  web_sourced_pyq
  user_created
}

enum TestType {
  topic_test
  revision_session
  mock_test
  scheduled_retest
}

enum TestStatus {
  scheduled
  ready
  in_progress
  completed
}

enum AttemptStatus {
  started
  submitted
  graded
}

enum FlashcardSource {
  auto_from_notes
  manual
}

enum Rating {
  again
  hard
  good
  easy
}

enum ChatRole {
  user
  assistant
  system
}

enum NotificationType {
  flashcards_due
  test_due
  revision_due
  weekly_report
  ingestion_complete
}

enum StudyPlanStatus {
  active
  archived
}

/** How long a mock or quiz should run. */
enum TestDurationMode {
  /// The exam board's published duration for that paper.
  official
  /// A fixed number of minutes the student chose.
  custom
  /// Derived from the question count and a per-question budget.
  per_question
}

/** What a scheduled block asks the student to actually do. */
enum StudyTaskKind {
  learn
  practice
  revise
  test
}

/**
 * Per-student exam preferences.
 *
 * Timing is the reason this table exists. A mock is only useful under the real
 * clock, but "the real clock" is not the same thing for everyone: a student two
 * weeks out wants the full 180 minutes, one squeezing practice into a lunch
 * break wants 45, and someone drilling speed wants a tighter budget than the
 * board allows. Rather than hardcode one of those, the duration is resolved at
 * test-start time from these settings, falling back to the published pattern.
 *
 * One row per user, created on first read so nothing has to seed it.
 */
model UserSettings {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")

  /// How the clock for a full mock is decided.
  testDurationMode  TestDurationMode @default(official) @map("test_duration_mode")
  /// Minutes, used when the mode is `custom`.
  customTestMinutes Int              @default(60) @map("custom_test_minutes")
  /// Seconds per question, used when the mode is `per_question`.
  secondsPerQuestion Int             @default(90) @map("seconds_per_question")
  /// Per-exam minute overrides keyed by ExamType, e.g. {"JEE_MAIN": 120}.
  examDurations     Json?            @map("exam_durations")

  /// Quizzes are short and optional-timer by default; mocks always run a clock.
  quizTimerEnabled       Boolean @default(true) @map("quiz_timer_enabled")
  quizSecondsPerQuestion Int     @default(90) @map("quiz_seconds_per_question")

  /// The real CBT submits for you when the clock hits zero.
  autoSubmitOnTimeUp Boolean @default(true) @map("auto_submit_on_time_up")
  showTimer          Boolean @default(true) @map("show_timer")
  /// Minutes remaining at which the clock starts warning.
  warnAtMinutes      Int     @default(5) @map("warn_at_minutes")
  /// Honour per-section limits (CAT, IBPS PO) rather than one pooled clock.
  enforceSectionalTiming Boolean @default(true) @map("enforce_sectional_timing")

  proctoringEnabled      Boolean @default(true) @map("proctoring_enabled")
  negativeMarkingEnabled Boolean @default(true) @map("negative_marking_enabled")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals               Goal[]
  contentItems        ContentItem[]
  questions           Question[]
  tests               Test[]
  testAttempts        TestAttempt[]
  flashcards          Flashcard[]
  flashcardReviews    FlashcardReview[]
  proficiencyScores   ProficiencyScore[]
  chatSessions        ChatSession[]
  notifications       Notification[]
  bankProgress        BankProgress[]
  mindMaps            MindMap[]
  studyPlans          StudyPlan[]
  settings            UserSettings?

  @@map("profiles")
}

/**
 * A dated study plan for one goal.
 *
 * Scheduling is deterministic (a weakness-weighted knapsack over the daily
 * minute budget); the AI contributes the rationale and per-task coaching notes.
 * Regenerating bumps `version` and rewrites only the *future* days, so a
 * student's completed history is never rewritten under them.
 */
model StudyPlan {
  id     String @id @default(uuid())
  userId String @map("user_id")
  goalId String @map("goal_id")

  title        String
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  dailyMinutes Int       @map("daily_minutes")

  status StudyPlanStatus @default(active)
  /// Plain-English explanation of why the plan is ordered the way it is.
  rationale   String?
  generatedBy String   @default("ai") @map("generated_by")
  /// Incremented every time performance data reshapes the plan.
  version     Int      @default(1)
  generatedAt DateTime @default(now()) @map("generated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal  Goal            @relation(fields: [goalId], references: [id], onDelete: Cascade)
  tasks StudyPlanTask[]

  @@index([userId])
  @@index([goalId])
  @@index([userId, status])
  @@map("study_plans")
}

model StudyPlanTask {
  id      String  @id @default(uuid())
  planId  String  @map("plan_id")
  topicId String? @map("topic_id")

  title       String
  description String?
  kind        StudyTaskKind
  minutes     Int           @default(30)
  /// The day this block belongs to, normalized to UTC midnight.
  scheduledFor DateTime     @map("scheduled_for")
  orderIndex   Int          @default(0) @map("order_index")
  /// Weakness-derived urgency (higher first); drives re-prioritisation.
  priority     Int          @default(0)

  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan  StudyPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  topic SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([planId])
  @@index([planId, scheduledFor])
  @@index([topicId])
  @@map("study_plan_tasks")
}

/**
 * An AI-generated memory map over a topic's notes.
 *
 * `data` holds a nested `{ label, detail?, children[] }` tree rather than
 * rendered geometry — layout is computed client-side, so the same map can be
 * re-laid out for different screen sizes without regenerating it.
 */
model MindMap {
  id            String  @id @default(uuid())
  userId        String  @map("user_id")
  topicId       String  @map("topic_id")
  /// Set when the map was built from one specific note rather than the whole topic.
  contentItemId String? @map("content_item_id")

  title String
  data  Json
  /// "ai" when Claude generated it, "offline" for the deterministic fallback.
  generatedBy String @default("ai") @map("generated_by")
  /// Denormalized node count, so lists don't have to walk the JSON.
  nodeCount   Int    @default(0) @map("node_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  contentItem ContentItem?  @relation(fields: [contentItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([topicId])
  @@map("mind_maps")
}

/**
 * A curated practice problem in the shared, exam-wide question bank.
 *
 * Distinct from `Question`, which is generated per user against their own
 * syllabus. Bank rows are global reference content — the "Striver sheet" — so
 * they carry no userId, and per-user state lives in `BankProgress`.
 */
model BankQuestion {
  id     String @id @default(uuid())
  /// Stable human-readable key so re-seeding updates rows instead of duplicating them.
  slug   String @unique

  examType   ExamType     @map("exam_type")
  subject    String
  chapter    String
  topic      String?
  type       QuestionType
  difficulty Difficulty

  content       String
  options       Json?
  correctAnswer String? @map("correct_answer")
  /// Worked approach, revealed after the user attempts the problem.
  solution      String?
  hint          String?

  marks           Int  @default(4)
  /// Target solve time, used to benchmark the per-question timer.
  expectedMinutes Int  @default(3) @map("expected_minutes")
  year            Int?

  sourceName String?  @map("source_name")
  sourceUrl  String?  @map("source_url")
  tags       String[] @default([])
  orderIndex Int      @default(0) @map("order_index")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  progress BankProgress[]

  @@index([examType, subject])
  @@index([examType, difficulty])
  @@index([examType, chapter])
  @@map("bank_questions")
}

/** One user's tick-off state and timing for one bank question. */
model BankProgress {
  id         String @id @default(uuid())
  userId     String @map("user_id")
  questionId String @map("question_id")

  solved     Boolean @default(false)
  bookmarked Boolean @default(false)
  attempts   Int     @default(0)
  /// Cumulative seconds across all attempts.
  timeSpentSec Int    @default(0) @map("time_spent_sec")
  /// Fastest single attempt, for comparison against `expectedMinutes`.
  bestTimeSec  Int?   @map("best_time_sec")
  notes        String?
  solvedAt     DateTime? @map("solved_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@index([userId, solved])
  @@index([questionId])
  @@map("bank_progress")
}

model Goal {
  id                String     @id @default(uuid())
  userId            String     @map("user_id")
  title             String
  examType          ExamType   @map("exam_type")
  examDate          DateTime?  @map("exam_date")
  dailyStudyMinutes Int?       @map("daily_study_minutes")
  status            GoalStatus @default(active)
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")

  user        Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  topics      SyllabusTopic[]
  questions   Question[]
  tests       Test[]
  chatSessions ChatSession[]
  studyPlans  StudyPlan[]

  @@index([userId])
  @@map("goals")
}

model SyllabusTopic {
  id          String      @id @default(uuid())
  goalId      String      @map("goal_id")
  parentId    String?     @map("parent_id")
  title       String
  description String?
  weight      Float       @default(1)
  orderIndex  Int         @default(0) @map("order_index")
  status      TopicStatus @default(not_started)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  goal              Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  parent            SyllabusTopic?     @relation("TopicTree", fields: [parentId], references: [id], onDelete: SetNull)
  children          SyllabusTopic[]    @relation("TopicTree")
  contentItems      ContentItem[]
  questions         Question[]
  flashcards        Flashcard[]
  proficiencyScores ProficiencyScore[]
  chatSessions      ChatSession[]
  mindMaps          MindMap[]
  planTasks         StudyPlanTask[]

  @@index([goalId])
  @@index([parentId])
  @@map("syllabus_topics")
}

model ContentItem {
  id          String      @id @default(uuid())
  topicId     String      @map("topic_id")
  userId      String      @map("user_id")
  type        ContentType
  title       String
  sourceUrl   String?     @map("source_url")
  rawText     String?     @map("raw_text")
  chunks      Json?
  embedding   Unsupported("vector(1536)")?
  metadata    Json?
  processedAt DateTime?   @map("processed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  topic    SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user     Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  mindMaps MindMap[]

  @@index([topicId])
  @@index([userId])
  @@index([type])
  @@map("content_items")
}

model Question {
  id            String         @id @default(uuid())
  topicId       String         @map("topic_id")
  goalId        String         @map("goal_id")
  userId        String?        @map("user_id")
  type          QuestionType
  difficulty    Difficulty
  content       String
  options       Json?
  correctAnswer String?        @map("correct_answer")
  rubric        Json?
  explanation   String?
  source        QuestionSource @default(llm_generated)
  isGeneric     Boolean        @default(false) @map("is_generic")
  metadata      Json?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  topic        SyllabusTopic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  goal         Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user         Profile?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  testQuestions TestQuestion[]
  answers      Answer[]

  @@index([topicId])
  @@index([goalId])
  @@index([userId])
  @@index([type])
  @@index([difficulty])
  @@map("questions")
}

model Test {
  id           String     @id @default(uuid())
  goalId       String     @map("goal_id")
  userId       String     @map("user_id")
  title        String
  type         TestType
  status       TestStatus @default(scheduled)
  scheduledAt  DateTime?  @map("scheduled_at")
  completedAt  DateTime?  @map("completed_at")
  settings     Json?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  goal     Goal           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user     Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions TestQuestion[]
  attempts TestAttempt[]

  @@index([goalId])
  @@index([userId])
  @@index([status])
  @@index([scheduledAt])
  @@map("tests")
}

model TestQuestion {
  id        String @id @default(uuid())
  testId    String @map("test_id")
  questionId String @map("question_id")
  orderIndex Int    @map("order_index")
  score     Int?

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([testId])
  @@index([questionId])
  @@map("test_questions")
}

model TestAttempt {
  id          String        @id @default(uuid())
  testId      String        @map("test_id")
  userId      String        @map("user_id")
  score       Int?
  maxScore    Int           @default(0) @map("max_score")
  status      AttemptStatus @default(started)
  startedAt   DateTime      @default(now()) @map("started_at")
  submittedAt DateTime?     @map("submitted_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  test    Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user    Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers Answer[]

  @@index([testId])
  @@index([userId])
  @@index([status])
  @@map("test_attempts")
}

model Answer {
  id         String    @id @default(uuid())
  attemptId  String    @map("attempt_id")
  questionId String    @map("question_id")
  response   String
  isCorrect  Boolean?  @map("is_correct")
  score      Int?
  maxScore   Int       @default(0) @map("max_score")
  feedback   String?
  gradedAt   DateTime? @map("graded_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

model Flashcard {
  id         String          @id @default(uuid())
  topicId    String          @map("topic_id")
  userId     String          @map("user_id")
  front      String
  back       String
  source     FlashcardSource @default(auto_from_notes)
  metadata   Json?
  // FSRS scheduling state lives on the card (source of truth for "due").
  // fsrsState holds the full serialized ts-fsrs Card; `due` is denormalized
  // for indexed querying of the review queue.
  due        DateTime        @default(now())
  fsrsState  Json?           @map("fsrs_state")
  reps       Int             @default(0)
  lapses     Int             @default(0)
  lastReview DateTime?       @map("last_review")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  topic    SyllabusTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user     Profile           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews  FlashcardReview[]

  @@index([topicId])
  @@index([userId])
  @@index([userId, due])
  @@map("flashcards")
}

model FlashcardReview {
  id         String   @id @default(uuid())
  flashcardId String  @map("flashcard_id")
  userId     String   @map("user_id")
  rating     Rating
  stability  Float
  difficulty Float
  dueDate    DateTime @map("due_date")
  reviewedAt DateTime @default(now()) @map("reviewed_at")

  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([flashcardId])
  @@index([userId])
  @@index([dueDate])
  @@map("flashcard_reviews")
}

model ProficiencyScore {
  id             String   @id @default(uuid())
  topicId        String   @map("topic_id")
  userId         String   @map("user_id")
  score          Float
  decayRate      Float    @default(0.05) @map("decay_rate")
  lastComputedAt DateTime @default(now()) @map("last_computed_at")

  topic SyllabusTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  user  Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([topicId, userId])
  @@index([topicId])
  @@index([userId])
  @@index([score])
  @@map("proficiency_scores")
}

model ChatSession {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  goalId    String?  @map("goal_id")
  topicId   String?  @map("topic_id")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     Profile       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal     Goal?         @relation(fields: [goalId], references: [id], onDelete: SetNull)
  topic    SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  messages ChatMessage[]

  @@index([userId])
  @@index([goalId])
  @@index([topicId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      ChatRole
  content   String
  sources   Json?
  createdAt DateTime @default(now()) @map("created_at")

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String
  dueAt     DateTime?        @map("due_at")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([dueAt])
  @@map("notifications")
}
